{
  "name": "a2matex-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop IDE for building and managing A2MaTeX Android automation workflows.",
  "author": {
    "name": "ngocmaii00",
    "email": "mailyngoc2301@gmail.com"
  },
  "desktopName": "com.a2matex.studio",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:desktop",
    "build": "npm run build:desktop",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:web": "vite --host 127.0.0.1 --port 15173 --strictPort",
    "dev:desktop": "npm run build:electron && concurrently -k -s first \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:electron": "wait-on http://127.0.0.1:15173 && cross-env ELECTRON_RUN_AS_NODE= A2MATEX_DEV_SERVER_URL=http://127.0.0.1:15173 electron .",
    "build:web": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/resolve-electron-aliases.mjs",
    "build:desktop": "npm run build:web && npm run build:electron",
    "typecheck": "tsc -b && tsc -p tsconfig.electron.json --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.{ts,cts}\" \"tests/**/*.{ts,tsx}\" \"*.{js,json,ts}\" \".github/**/*.yml\" --no-error-on-unmatched-pattern",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"electron/**/*.{ts,cts}\" \"tests/**/*.{ts,tsx}\" \"*.{js,json,ts}\" \".github/**/*.yml\" --no-error-on-unmatched-pattern",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build:desktop",
    "package": "npm run build:desktop && electron-builder --dir",
    "dist": "npm run build:desktop && electron-builder",
    "dist:win": "npm run build:desktop && electron-builder --win nsis --x64",
    "dist:mac": "npm run build:desktop && electron-builder --mac dmg",
    "dist:linux": "npm run build:desktop && electron-builder --linux AppImage deb --x64"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@xyflow/react": "^12.12.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.14.2",
    "react-router-dom": "^7.18.4",
    "saxes": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.5.1"
  },
  "main": "dist-electron/electron/main/bootstrap.js",
  "overrides": {
    "dompurify": "3.4.16",
    "shell-quote": "1.12.0"
  },
  "build": {
    "appId": "com.a2matex.studio",
    "productName": "A2MaTeX_Studio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "prisma/migration/**/*",
      "package.json",
      ".env"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "syncDesktopName": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
