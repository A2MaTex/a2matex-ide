{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "paths": {
      "@/*": ["./src/*.ts"],
      "@app/*": ["./src/app/*.ts"],
      "@domain/*": ["./src/domain/*.ts"],
      "@application/*": ["./src/application/*.ts"],
      "@infrastructure/*": ["./src/infrastructure/*.ts"],
      "@presentation/*": ["./src/presentation/*.ts"],
      "@shared/*": ["./src/shared/*.ts"],
      "@electron/*": ["./electron/*.ts", "./electron/*.cts"]
    },
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "rootDir": ".",
    "outDir": "dist-electron",
    "sourceMap": true
  },
  "include": ["electron/**/*.ts", "electron/**/*.cts", "src/shared/host/**/*.ts"]
}
